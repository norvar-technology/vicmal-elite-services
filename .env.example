# --- Paystack ---
# Secret key: used ONLY server-side (app/api/paystack routes). Never expose this.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key: safe for the browser, used to brand the checkout button.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Site ---
# Full production URL, no trailing slash. Used for OG tags, sitemap, callback_url.
NEXT_PUBLIC_SITE_URL=https://vicmaleliteservices.com

# --- WhatsApp (Vicmal Elite Services business line) ---
# Digits only, international format, no + and no leading 0.
# Example: an 080 number becomes 234801234567
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# --- Media (Cloudflare R2, served via file.decklo.xzy) ---
NEXT_PUBLIC_MEDIA_BASE_URL=https://file.decklo.xzy

# --- Norvar Technology Ltd (footer credit WhatsApp link) ---
NEXT_PUBLIC_NORVAR_WHATSAPP_NUMBER=2349039048518
